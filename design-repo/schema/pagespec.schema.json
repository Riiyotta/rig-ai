        "primaryCta": {
          "$ref": "#/definitions/cta"
        },
        "ticker": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/tickerItem"
          },
          "minItems": 1,
          "maxItems": 7
        }
      },
      "required": [
        "navLogo",
        "navCta",
        "headlineLines",
        "subhead",
        "primaryCta",
        "ticker"
      ],
      "additionalProperties": false
    },
    "content_problem_funnel_cards": {
