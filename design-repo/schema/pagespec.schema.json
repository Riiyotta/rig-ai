{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rig-ai-design-repo/pagespec.schema.json",
  "title": "Rig.ai clone PageSpec",
  "type": "object",
  "properties": {
    "pageSpecVersion": {
      "const": "1.0.0"
    },
    "template": {
      "enum": [
        "template.home"
      ]
    },
    "route": {
      "$ref": "#/definitions/internalHref"
    },
    "meta": {
      "$ref": "#/definitions/meta"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      },
      "minItems": 1
    }
  },
  "required": [
    "pageSpecVersion",
    "template",
    "route",
    "meta",
    "nodes"
  ],
  "additionalProperties": false,
  "definitions": {
    "internalHref": {
      "type": "string",
      "pattern": "^(#[A-Za-z0-9_-]*|/(?![/\\\\])[A-Za-z0-9._~/-]*)$",
      "description": "INTERNAL ONLY: '#', '#fragment' or a root-relative path. Rejects http(s)://, //host, mailto:, tel:, javascript:, data:, backslash tricks."
    },
    "cta": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "$ref": "#/definitions/internalHref"
        }
      },
      "required": [
        "label",
        "href"
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "assetRole": {
          "enum": [
            "brand.logo",
            "brand.mark",
            "brand.wordmark",
            "decor.badge-glyph",
            "decor.wave-grid",
            "editorial.news-headline",
            "illustration.product-demo",
            "illustration.review-funnel",
            "illustration.schematic",
            "meta.og-image",
            "thirdparty.tool-logo"
          ]
        },
        "source": {
          "enum": [
            "placeholder",
            "user-supplied-licensed",
            "generated-original"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "assetRole",
        "source",
        "label"
      ],
      "additionalProperties": false
    },
    "tickerItem": {
      "type": "object",
      "properties": {
        "assetRole": {
          "enum": [
            "brand.logo",
            "brand.mark",
            "brand.wordmark",
            "decor.badge-glyph",
            "decor.wave-grid",
            "editorial.news-headline",
            "illustration.product-demo",
            "illustration.review-funnel",
            "illustration.schematic",
            "meta.og-image",
            "thirdparty.tool-logo"
          ]
        },
        "source": {
          "enum": [
            "placeholder",
            "user-supplied-licensed",
            "generated-original"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "$ref": "#/definitions/internalHref"
        }
      },
      "required": [
        "assetRole",
        "source",
        "text",
        "href"
      ],
      "additionalProperties": false
    },
    "stackItem": {
      "type": "object",
      "properties": {
        "assetRole": {
          "enum": [
            "brand.logo",
            "brand.mark",
            "brand.wordmark",
            "decor.badge-glyph",
            "decor.wave-grid",
            "editorial.news-headline",
            "illustration.product-demo",
            "illustration.review-funnel",
            "illustration.schematic",
            "meta.og-image",
            "thirdparty.tool-logo"
          ]
        },
        "source": {
          "enum": [
            "placeholder",
            "user-supplied-licensed",
            "generated-original"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "assetRole",
        "source",
        "name"
      ],
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "properties": {
        "pattern": {
          "enum": [
            "cta-flow-glow-glitch",
            "disclosure-grid-rows",
            "film-grain-overlay",
            "none",
            "review-funnel-loop",
            "status-blink",
            "stepper-autoadvance",
            "ticker-marquee",
            "walkthrough-autoplay"
          ]
        },
        "reducedMotionFallback": {
          "enum": [
            "flow-dots-hidden",
            "funnel-static-frame",
            "none",
            "stepper-autoadvance-schematics-static",
            "ticker-static-scrollable",
            "ungated-in-source",
            "walkthrough-manual-full-scenes"
          ]
        }
      },
      "required": [
        "pattern",
        "reducedMotionFallback"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "cta-flow-glow-glitch"
              }
            }
          },
          "then": {
            "properties": {
              "reducedMotionFallback": {
                "const": "flow-dots-hidden"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "disclosure-grid-rows"
              }
            }
          },
          "then": {
            "properties": {
              "reducedMotionFallback": {
                "const": "ungated-in-source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "film-grain-overlay"
              }
            }
          },
          "then": {
            "properties": {
              "reducedMotionFallback": {
                "const": "ungated-in-source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "reducedMotionFallback": {
                "const": "none"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "review-funnel-loop"
              }
            }
          },
          "then": {
            "properties": {
              "reducedMotionFallback": {
                "const": "funnel-static-frame"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "status-blink"
              }
            }
          },
          "then": {
            "properties": {
              "reducedMotionFallback": {
                "const": "ungated-in-source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "stepper-autoadvance"
              }
            }
          },
          "then": {
            "properties": {
              "reducedMotionFallback": {
                "const": "stepper-autoadvance-schematics-static"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "ticker-marquee"
              }
            }
          },
          "then": {
            "properties": {
              "reducedMotionFallback": {
                "const": "ticker-static-scrollable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "walkthrough-autoplay"
              }
            }
          },
          "then": {
            "properties": {
              "reducedMotionFallback": {
                "const": "walkthrough-manual-full-scenes"
              }
            }
          }
        }
      ]
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
