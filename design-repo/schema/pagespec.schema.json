    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "section": {
          "enum": [
            "chrome.overlays",
            "hero.headline-ticker",
            "problem.funnel-cards",
            "feature.walkthrough",
            "comparison.evidence",
            "steps.stepper",
            "benefits.funnel-split",
            "setup.steps-stack",
            "faq.accordion",
            "conversion.cta-glitch",
            "shell.footer"
          ]
        },
        "region": {
          "enum": [
            "chrome",
            "pre-main",
            "main",
            "post-main"
          ]
        },
        "surface": {
          "type": "string",
          "pattern": "^color\\.surface\\.[a-z-]+$"
        },
        "content": {
          "type": "object"
        },
        "motion": {
          "$ref": "#/definitions/motion"
