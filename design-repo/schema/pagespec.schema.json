        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "illustration": {
          "$ref": "#/definitions/media"
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "number": {
                "type": "string",
                "pattern": "^[0-9]{3}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "number",
              "title",
              "body"
            ],
            "additionalProperties": false
          },
          "minItems": 4,
          "maxItems": 4
